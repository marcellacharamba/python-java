def km_para_milhas(km):
    return km * 0.621371

def metros_para_centimetros(m):
    return m * 100

def litros_para_mililitros(l):
    return l * 1000

# Exemplos:
print(km_para_milhas(10), "milhas")
print(metros_para_centimetros(5), "cm")
print(litros_para_mililitros(2), "ml")


