def calcular_media(n1, n2, n3):
    media = (n1 + n2 + n3) / 3
    if media >= 7:
        return f"Média: {media:.2f} - Aprovado"
    else:
        return f"Média: {media:.2f} - Reprovado"

# Exemplo:
print(calcular_media(6.5, 7.0, 8.0))


